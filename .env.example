# Public template - do not add real keys here

# Chat models, every chapter. https://console.groq.com/keys
GROQ_API_KEY=

# Embeddings, 04_memory onwards. Groq serves no embedding model, so this is the
# one place the repo uses another provider. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Graph store, 04_memory/02_stores.ipynb onwards. Neo4j has no embedded mode, so
# this is the only part of the repo needing a server. A free instance takes about
# two minutes to create: https://console.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
