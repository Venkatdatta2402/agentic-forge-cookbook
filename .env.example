# Public template - do not add real keys here

# Chat models, every chapter. https://console.groq.com/keys
GROQ_API_KEY=

# Embeddings, 04_memory onwards. Groq serves no embedding model, so this is the
# one place the repo uses another provider. https://aistudio.google.com/apikey
# Also Mem0's own model in 08_frameworks/06_mem0 (gemini-3.5-flash-lite).
GEMINI_API_KEY=

# Optional, 08_frameworks/07_langsmith: the claim judge (gemini-2.5-flash) reads
# this first, else GEMINI_API_KEY. Newer keys could not use gemini-2.5-flash, and
# the free tier allows about 20 requests a day per model, so a second key helps.
GEMINI_API_KEY_JUDGE=

# Graph store, 04_memory/02_stores.ipynb onwards. Neo4j has no embedded mode, so
# this is the only part of the repo needing a server. A free instance takes about
# two minutes to create: https://console.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Tracing and evaluation, 08_frameworks/07_langsmith. https://smith.langchain.com
LANGSMITH_API_KEY=

# Observability, 08_frameworks/08_langfuse. https://cloud.langfuse.com -- the base
# URL is your project's region, e.g. https://cloud.langfuse.com or
# https://us.cloud.langfuse.com. (LANGFUSE_HOST is the deprecated name.)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
