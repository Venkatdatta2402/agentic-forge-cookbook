# Public template - do not add real keys here

# Which provider llm.py starts on, and optionally which model. Both optional;
# defaults to groq and that provider's own default model.
# Switch at any time from code instead: llm.use("gemini", "gemini-2.5-flash-lite")
LLM_PROVIDER=groq
LLM_MODEL=

# Set the key for whichever providers you want available. Only the active one is required.
# llm.providers() shows which of these are actually set.

# https://console.groq.com/keys
# free: 100k tokens/day, 12k tokens/minute. Fast, but 02_agent_runtime's forking
# demos can exhaust the daily cap in a single run.
GROQ_API_KEY=

# https://aistudio.google.com/apikey
# free: 250k tokens/minute, 1500 requests/day, 1M context. The roomiest of the three.
GEMINI_API_KEY=

# https://cloud.cerebras.ai
# free: 1M tokens/day, but only an 8K context window - fine for 01_foundations and
# the earlier 02_agent_runtime notebooks, tight for the sub-agent ones.
CEREBRAS_API_KEY=
