# Stats Desk settings. Copy to .env (never committed) and fill in what you use.
# Locally every .env from this folder up to the repo root is read, nearest first; on Cloud Run
# these are set on the service instead (keys as Secret Manager secrets).

# --- Groq (console.groq.com/keys) ---------------------------------------------------------
# The server's own key: scripts/ask.py, the evals, span tests.
GROQ_API_KEY=
# Free questions for visitors who bring no key: the desk's own keys, comma-separated, each on a
# DIFFERENT Groq organisation (limits are per organisation: two keys of one share one allowance).
# Leave empty to require every visitor's own key. A key is used until Groq says its day is spent;
# a question that runs one dry carries on on the other.
STATS_DESK_FREE_GROQ_KEYS=
# Free questions per visitor (internet address) per day, new questions and follow-ups together
STATS_DESK_FREE_PER_VISITOR_PER_DAY=3
# Each free key's daily tokens at Groq (the desk counts their last 24 hours; use the keys for
# nothing else, or the count misses that use), and the least left to start a question on
STATS_DESK_FREE_TOKENS_PER_DAY=200000
STATS_DESK_FREE_MIN_LEFT=20000

# --- Models (both gpt-oss-120b unless changed) ----------------------------------------------
STATS_DESK_LEAD_MODEL=openai/gpt-oss-120b
STATS_DESK_ANALYST_MODEL=openai/gpt-oss-120b

# --- Langfuse (traces of every question; off when the keys are empty) -----------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

# --- Where briefs are kept --------------------------------------------------------------------
# memory (local: gone on restart) or cosmos (Azure Cosmos DB; signs in by identity: your
# `az login` locally, the app's managed identity on Azure -- no key goes here)
STATS_DESK_STORE=memory
STATS_DESK_COSMOS_URL=https://<account>.documents.azure.com:443/
STATS_DESK_COSMOS_DATABASE=stats_desk

# --- Serving -----------------------------------------------------------------------------------
# questions running at once on one machine
STATS_DESK_MAX_RUNNING=10
# the machine's shared analysis server (loopback only)
STATS_DESK_ANALYSIS_PORT=8765
# the release file (the Docker image sets this)
# STATS_DESK_RELEASE=data/release/plfs.duckdb
